// Cloudflare deploy settings. "wrangler deploy" uploads the built site in ./dist
// to Cloudflare's network as a Worker with static assets.
{
  "name": "todo-app",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Any unknown URL serves index.html, so React handles the page
    // (needed for links like password-reset that come back to the app).
    "not_found_handling": "single-page-application"
  },
  // Serve the app on your own subdomain. Cloudflare creates the DNS record
  // and the HTTPS certificate automatically on the next deploy.
  "routes": [
    { "pattern": "todo.fannycynthia.com", "custom_domain": true }
  ],
  // Turn off the old todo-app.fanny-cynthia.workers.dev address so the app
  // only lives at https://todo.fannycynthia.com.
  "workers_dev": false,
  "preview_urls": false
}
